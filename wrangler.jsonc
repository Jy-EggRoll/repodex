{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repodex",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-10",
  "assets": {
    "directory": "./dist/",
    "binding": "public_assets",
    "run_worker_first": true,
  },
  "kv_namespaces": [
    {
      "binding": "repo_index_kv",
    },
  ],
}
